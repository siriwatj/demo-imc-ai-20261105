<!DOCTYPE html>
<html class="dark" lang="th">
<%- include('partials/head', { title: 'การตั้งค่า · SlipFlow' }) %>
<body class="bg-background font-body text-on-surface antialiased selection:bg-primary selection:text-on-primary min-h-screen">
<%- include('partials/sidebar', { activePath, balance }) %>
<div class="md:pl-64">
<%- include('partials/header') %>
<main class="relative pt-16 w-full px-8 bg-background min-h-screen">
<div class="flex flex-col w-full pb-16">

<section class="relative pt-6 pb-8">
  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-high text-xs font-label text-secondary mb-3 shadow-[0_0_12px_rgba(0,255,204,0.15)]">
    <span class="w-1.5 h-1.5 rounded-full bg-secondary animate-ping"></span>
    <span>CONFIG // OPERATOR PROFILE</span>
  </div>
  <h1 class="text-3xl lg:text-4xl font-headline font-bold text-on-surface tracking-tight">การตั้งค่า</h1>
  <p class="text-on-surface-variant font-body text-sm lg:text-base mt-2 max-w-2xl">จัดการข้อมูลบัญชี การแจ้งเตือน และความปลอดภัยของระบบ</p>
</section>

<div class="grid grid-cols-1 xl:grid-cols-12 gap-8">
  <div class="xl:col-span-7 rounded-2xl bg-surface-container p-6 shadow-xl">
    <h3 class="font-headline font-bold text-base text-on-surface mb-6">ข้อมูลบัญชี</h3>
    <form class="space-y-5">
      <div>
        <label class="block text-[11px] font-label uppercase tracking-wider text-on-surface-variant mb-1.5" for="settingsUsername">ชื่อผู้ใช้งาน</label>
        <input class="w-full bg-surface-container-low border-0 border-b-2 border-outline-variant focus:border-secondary focus:ring-0 focus:shadow-[0_4px_12px_-4px_rgba(0,255,204,0.3)] rounded-lg text-sm text-on-surface px-3.5 py-2.5 transition-all" id="settingsUsername" type="text" value="Cyber Operator" />
      </div>
      <div>
        <label class="block text-[11px] font-label uppercase tracking-wider text-on-surface-variant mb-1.5" for="settingsEmail">อีเมล</label>
        <input class="w-full bg-surface-container-low border-0 border-b-2 border-outline-variant focus:border-secondary focus:ring-0 focus:shadow-[0_4px_12px_-4px_rgba(0,255,204,0.3)] rounded-lg text-sm text-on-surface px-3.5 py-2.5 transition-all" id="settingsEmail" type="email" value="operator@slipflow.io" />
      </div>
      <div>
        <label class="block text-[11px] font-label uppercase tracking-wider text-on-surface-variant mb-1.5" for="settingsPassword">รหัสผ่านใหม่</label>
        <input class="w-full bg-surface-container-low border-0 border-b-2 border-outline-variant focus:border-secondary focus:ring-0 focus:shadow-[0_4px_12px_-4px_rgba(0,255,204,0.3)] rounded-lg text-sm text-on-surface px-3.5 py-2.5 transition-all" id="settingsPassword" placeholder="••••••••" type="password" />
      </div>
      <button class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-surface-container-high text-on-surface font-headline font-bold text-sm shadow-[0_0_20px_rgba(255,45,120,0.2)] hover:shadow-[0_0_24px_rgba(255,45,120,0.4)] hover:text-primary transition-all active:scale-95" type="button">
        <span class="material-symbols-outlined text-primary text-lg">save</span>
        บันทึกการเปลี่ยนแปลง
      </button>
    </form>
  </div>

  <div class="xl:col-span-5 space-y-6">
    <div class="rounded-2xl bg-surface-container p-6 shadow-xl">
      <h3 class="font-headline font-bold text-base text-on-surface mb-5">การแจ้งเตือน</h3>
      <div class="space-y-4">
        <% const toggles = [
          { label: 'แจ้งเตือนเมื่อสแกนสลิปสำเร็จ', checked: true },
          { label: 'แจ้งเตือนเมื่อพบความผิดปกติ', checked: true },
          { label: 'สรุปยอดรายสัปดาห์ทางอีเมล', checked: false },
        ]; %>
        <% toggles.forEach((toggle) => { %>
        <div class="flex items-center justify-between">
          <span class="text-xs font-body text-on-surface"><%= toggle.label %></span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input class="sr-only peer" type="checkbox" <%= toggle.checked ? 'checked' : '' %> />
            <div class="w-10 h-5.5 h-6 bg-surface-container-high rounded-full peer peer-checked:bg-secondary/30 transition-colors"></div>
            <div class="absolute left-0.5 top-0.5 w-5 h-5 rounded-full bg-on-surface-variant peer-checked:bg-secondary peer-checked:translate-x-4 peer-checked:shadow-[0_0_8px_#00ffcc] transition-all"></div>
          </label>
        </div>
        <% }) %>
      </div>
    </div>

    <div class="rounded-2xl bg-surface-container p-6 shadow-xl">
      <h3 class="font-headline font-bold text-base text-on-surface mb-5">ความปลอดภัย</h3>
      <div class="flex items-center justify-between p-3 rounded-xl bg-surface-container-low">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-secondary text-lg">security</span>
          <span class="text-xs font-body text-on-surface">ยืนยันตัวตนสองชั้น (2FA)</span>
        </div>
        <span class="px-2.5 py-1 rounded-full text-[10px] font-label font-bold bg-secondary/15 text-secondary">เปิดใช้งาน</span>
      </div>
    </div>
  </div>
</div>

</div>
</main>
</div>
</body>
</html>
