<header class="fixed top-0 left-0 md:left-64 right-0 h-16 bg-surface/85 backdrop-blur-xl shadow-[0_4px_20px_rgba(0,0,0,0.4)] z-40 flex items-center justify-between px-4 md:px-8">
  <div class="flex items-center gap-3">
    <button onclick="toggleSidebar()" class="md:hidden w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center text-on-surface-variant hover:text-secondary hover:bg-surface-container-high transition-all shadow-[0_0_8px_rgba(0,0,0,0.2)]" aria-label="เปิดเมนู">
      <span class="material-symbols-outlined text-[20px]">menu</span>
    </button>
    <div class="h-2 w-2 rounded-full bg-secondary shadow-[0_0_8px_#00ffcc] hidden sm:block"></div>
    <span class="text-xs font-label uppercase tracking-widest text-on-surface-variant hidden sm:inline">SLIPFLOW // CORE SYSTEM ONLINE</span>
  </div>
  <div class="flex items-center gap-4">
    <button class="w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center text-on-surface-variant hover:text-secondary hover:bg-surface-container-high transition-all shadow-[0_0_8px_rgba(0,0,0,0.2)]">
      <span class="material-symbols-outlined text-[20px]">search</span>
    </button>
    <button class="relative w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface-container-high transition-all shadow-[0_0_8px_rgba(0,0,0,0.2)]">
      <span class="material-symbols-outlined text-[20px]">notifications</span>
      <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-primary shadow-[0_0_6px_#ff2d78]"></span>
    </button>
    <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">
      <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
    </div>
  </div>
</header>
