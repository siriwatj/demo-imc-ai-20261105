<!DOCTYPE html>
<html class="dark" lang="th">
<%- include('partials/head', { title: 'แดชบอร์ด · SlipFlow' }) %>
<body class="bg-background font-body text-on-surface antialiased selection:bg-primary selection:text-on-primary min-h-screen">
<%- include('partials/sidebar', { activePath, balance }) %>
<div class="md:pl-64">
<%- include('partials/header') %>
<main class="relative pt-16 w-full px-8 bg-background min-h-screen">
<div class="flex flex-col w-full pb-16">

<section class="relative pt-6 pb-8 overflow-hidden">
  <div class="absolute -top-24 left-1/3 w-96 h-96 bg-primary/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="relative z-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-high text-xs font-label text-secondary mb-3 shadow-[0_0_12px_rgba(0,255,204,0.15)]">
      <span class="w-1.5 h-1.5 rounded-full bg-secondary animate-ping"></span>
      <span>OVERVIEW // MISSION CONTROL</span>
    </div>
    <h1 class="text-3xl lg:text-4xl font-headline font-bold text-on-surface tracking-tight">แดชบอร์ด</h1>
    <p class="text-on-surface-variant font-body text-sm lg:text-base mt-2 max-w-2xl">ภาพรวมยอดเงินและสลิปล่าสุดของคุณแบบเรียลไทม์</p>
  </div>
</section>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10">
  <div class="rounded-2xl bg-surface-container p-6 shadow-xl">
    <div class="flex items-center gap-2 mb-3">
      <span class="material-symbols-outlined text-secondary text-lg">account_balance_wallet</span>
      <span class="text-xs font-label uppercase tracking-wider text-on-surface-variant">ยอดเงินคงเหลือสุทธิ</span>
    </div>
    <div class="text-2xl font-label font-bold text-secondary">฿<%= Number(balance).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></div>
  </div>
  <div class="rounded-2xl bg-surface-container p-6 shadow-xl">
    <div class="flex items-center gap-2 mb-3">
      <span class="material-symbols-outlined text-primary text-lg">document_scanner</span>
      <span class="text-xs font-label uppercase tracking-wider text-on-surface-variant">โควตา OCR วันนี้</span>
    </div>
    <div class="text-2xl font-label font-bold text-on-surface"><%= quota.used %> <span class="text-sm text-on-surface-variant">/ <%= quota.total %></span></div>
  </div>
  <div class="rounded-2xl bg-surface-container p-6 shadow-xl">
    <div class="flex items-center gap-2 mb-3">
      <span class="material-symbols-outlined text-tertiary text-lg">verified_user</span>
      <span class="text-xs font-label uppercase tracking-wider text-on-surface-variant">ธนาคารที่รองรับ</span>
    </div>
    <div class="text-2xl font-label font-bold text-on-surface"><%= banks.length %> <span class="text-sm text-on-surface-variant">แห่ง</span></div>
  </div>
</div>

<div class="rounded-2xl bg-surface-container p-6 shadow-xl mt-8 relative z-10">
  <div class="flex items-center justify-between mb-5">
    <h3 class="font-headline font-bold text-base text-on-surface">สลิปล่าสุด</h3>
    <a class="text-xs font-label text-secondary hover:text-primary transition-colors" href="/transactions">ดูทั้งหมด &rarr;</a>
  </div>
  <div class="space-y-2">
    <% recentSlips.forEach((slip) => { %>
    <% const bank = getBank(slip.bankCode); %>
    <div class="flex items-center justify-between p-3 rounded-xl bg-surface-container-low">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: <%= bank.color %>; box-shadow: 0 0 6px <%= bank.color %>"></div>
        <div class="min-w-0">
          <div class="text-xs font-label font-bold text-on-surface truncate"><%= slip.fileName %></div>
          <div class="text-[11px] text-on-surface-variant font-body"><%= bank.nameTh %> &middot; <%= slip.uploadedAt.toLocaleDateString('th-TH') %></div>
        </div>
      </div>
      <div class="text-right shrink-0 pl-3">
        <div class="font-label font-bold text-secondary text-sm">฿<%= Number(slip.amount).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></div>
        <div class="text-[10px] font-label uppercase text-on-surface-variant"><%= slip.status %></div>
      </div>
    </div>
    <% }) %>
  </div>
</div>

</div>
</main>
</div>
</body>
</html>
