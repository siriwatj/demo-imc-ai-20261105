<!DOCTYPE html>
<html class="dark" lang="th">
<%- include('partials/head', { title: 'อัปโหลดสลิป · SlipFlow' }) %>
<body class="bg-background font-body text-on-surface antialiased selection:bg-primary selection:text-on-primary min-h-screen">
<%- include('partials/sidebar', { activePath, balance }) %>
<div class="md:pl-64">
<%- include('partials/header') %>
<main class="relative pt-16 w-full px-8 bg-background min-h-screen">
<div class="flex flex-col w-full pb-16">

<section class="relative pt-6 pb-8 overflow-hidden">
  <div class="absolute -top-24 left-1/3 w-96 h-96 bg-primary/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute -top-10 right-10 w-80 h-80 bg-secondary/10 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 relative z-10">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-high text-xs font-label text-secondary mb-3 shadow-[0_0_12px_rgba(0,255,204,0.15)]">
        <span class="w-1.5 h-1.5 rounded-full bg-secondary animate-ping"></span>
        <span>STEP 01 // INGESTION ENGINE</span>
      </div>
      <h1 class="text-3xl lg:text-4xl font-headline font-bold text-on-surface tracking-tight">
        อัปโหลดสลิปโอนเงิน / <span class="text-primary [text-shadow:0_0_16px_rgba(255,45,120,0.5)]">ใบเสร็จ</span>
      </h1>
      <p class="text-on-surface-variant font-body text-sm lg:text-base mt-2 max-w-2xl">
        ลากและวางสลิปเพื่อสแกนและดึงข้อมูลอัตโนมัติด้วยระบบ AI OCR ความแม่นยำสูง รองรับทุกธนาคารในไทย
      </p>
    </div>
    <div class="flex items-center gap-4 bg-surface-container px-4 py-2.5 rounded-xl shadow-lg">
      <div class="flex flex-col">
        <span class="text-[10px] font-label uppercase text-on-surface-variant">OCR Engine Status</span>
        <span class="text-xs font-label text-secondary font-semibold flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-secondary"></span> V3.4 NEURAL LATENCY 140ms
        </span>
      </div>
      <div class="h-6 w-px bg-outline-variant"></div>
      <div class="flex flex-col">
        <span class="text-[10px] font-label uppercase text-on-surface-variant">โควตาวันนี้</span>
        <span class="text-xs font-label text-on-surface font-bold"><%= quota.used %> / <%= quota.total %> รายการ</span>
      </div>
    </div>
  </div>
</section>

<div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start relative z-10">
  <div class="xl:col-span-7 space-y-6">
    <form id="uploadForm" onsubmit="return false;">
    <div id="uploadError" data-testid="test_id_uploadError" class="hidden mb-4 px-4 py-3 rounded-xl bg-error-container text-on-error-container text-sm font-body flex items-center gap-2">
      <span class="material-symbols-outlined text-base">error</span>
      <span id="uploadErrorText"></span>
    </div>
    <div class="group relative rounded-2xl bg-surface-container p-8 transition-all duration-300 shadow-[0_8px_30px_rgba(0,0,0,0.4)] hover:shadow-[0_0_24px_rgba(0,255,204,0.18)] cursor-pointer overflow-hidden" id="dropzone" data-testid="test_id_dropzone">
      <div class="absolute -right-20 -bottom-20 w-64 h-64 bg-secondary/10 rounded-full blur-[80px] pointer-events-none group-hover:bg-primary/20 transition-all duration-500"></div>
      <input accept="image/png,image/jpeg,application/pdf" aria-label="เลือกไฟล์สลิป" class="hidden" id="slipFileInput" name="slipFile" type="file" />
      <div class="relative z-10 flex flex-col items-center text-center py-6 px-4">
        <div class="relative mb-6">
          <div class="w-24 h-24 rounded-2xl bg-surface-container-high flex items-center justify-center shadow-[inset_0_0_16px_rgba(0,255,204,0.12)] group-hover:scale-105 transition-transform duration-300">
            <span class="material-symbols-outlined text-[44px] text-secondary group-hover:text-primary transition-colors">document_scanner</span>
          </div>
          <div class="absolute -inset-1.5 rounded-2xl bg-gradient-to-tr from-secondary/40 to-primary/40 -z-10 blur-sm opacity-60 group-hover:opacity-100 transition-opacity"></div>
          <div class="absolute -top-1 -right-1 flex h-4 w-4">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span>
            <span class="relative inline-flex rounded-full h-4 w-4 bg-secondary"></span>
          </div>
        </div>
        <h2 class="text-xl font-headline font-bold text-on-surface mb-2" id="dropzoneLabel">ลากสลิปมาวางที่นี่ หรือคลิกเพื่อค้นหา</h2>
        <p class="text-sm font-body text-on-surface-variant max-w-md mb-6 leading-relaxed">
          ระบบรองรับไฟล์รูปภาพ JPG หรือ PNG สลิปจาก Mobile Banking ทุกธนาคาร ขนาดไฟล์สูงสุดไม่เกิน 5MB
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3 mb-8">
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-xs font-label text-secondary flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm">image</span> JPG / JPEG
          </span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-xs font-label text-secondary flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm">filter</span> PNG 24-BIT
          </span>
          <span class="px-2.5 py-1 rounded bg-surface-container-highest text-xs font-label text-on-surface-variant">MAX 5 MB</span>
        </div>
        <button class="relative inline-flex items-center gap-3 px-8 py-3.5 rounded-xl bg-surface-container-high text-on-surface font-headline font-bold text-sm tracking-wide shadow-[0_0_20px_rgba(0,255,204,0.15)] hover:shadow-[0_0_25px_rgba(0,255,204,0.35)] hover:text-secondary transition-all active:scale-95" onclick="document.getElementById('slipFileInput').click()" type="button">
          <span class="material-symbols-outlined text-secondary text-lg">add_photo_alternate</span>
          <span>เลือกไฟล์สลิปจากอุปกรณ์</span>
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
      <div class="p-5 rounded-2xl bg-surface-container flex items-start gap-4 hover:bg-surface-container-high transition-colors cursor-pointer group shadow-md">
        <div class="w-12 h-12 rounded-xl bg-surface-container-high group-hover:bg-primary/20 flex items-center justify-center shrink-0 transition-colors">
          <span class="material-symbols-outlined text-secondary group-hover:text-primary text-2xl transition-colors">layers</span>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-headline font-semibold text-on-surface">อัปโหลดสลิปแบบกลุ่ม</h3>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-label bg-primary/20 text-primary">BATCH x20</span>
          </div>
          <p class="text-xs text-on-surface-variant font-body mt-1 leading-normal">
            อัปโหลดครั้งละหลายรายการ เหมาะสำหรับการสรุปยอดบิลประจำวันหรือรอบสต็อก
          </p>
        </div>
      </div>
      <div class="p-5 rounded-2xl bg-surface-container flex items-start gap-4 hover:bg-surface-container-high transition-colors cursor-pointer group shadow-md">
        <div class="w-12 h-12 rounded-xl bg-surface-container-high group-hover:bg-secondary/20 flex items-center justify-center shrink-0 transition-colors">
          <span class="material-symbols-outlined text-secondary text-2xl">photo_camera</span>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-headline font-semibold text-on-surface">เปิดกล้องสแกนสด</h3>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-label bg-secondary/20 text-secondary">LIVE AUTO-DETECT</span>
          </div>
          <p class="text-xs text-on-surface-variant font-body mt-1 leading-normal">
            จับคู่เฟรมอัตโนมัติพร้อมตัดขอบและปรับแต่งระดับแสงด้วยคอมพิวเตอร์วิทัศน์
          </p>
        </div>
      </div>
    </div>

    <div class="p-5 rounded-2xl bg-surface-container-low shadow-sm mt-6">
      <div class="flex items-center justify-between mb-3.5">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-secondary text-base">verified_user</span>
          <span class="text-xs font-label uppercase tracking-wider text-on-surface-variant">รองรับสลิปสแกนตรวจสอบทุกธนาคารชั้นนำ</span>
        </div>
        <span class="text-[11px] font-label text-secondary flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
          เชื่อมต่อ ธปท. Direct API
        </span>
      </div>
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-2.5">
        <% banks.forEach((bank) => { %>
        <label class="flex items-center gap-2 px-3 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high transition-colors cursor-pointer">
          <input class="hidden peer" name="bankCode" type="radio" value="<%= bank.code %>" <%= bank.code === 'KBANK' ? 'checked' : '' %> />
          <div class="w-3.5 h-3.5 rounded-full shrink-0 peer-checked:ring-2 peer-checked:ring-offset-2 peer-checked:ring-offset-surface-container peer-checked:ring-current" style="background-color: <%= bank.color %>; box-shadow: 0 0 6px <%= bank.color %>; color: <%= bank.color %>"></div>
          <div class="min-w-0">
            <span class="block text-xs font-label font-bold text-on-surface truncate"><%= bank.code %></span>
            <span class="block text-[9px] text-on-surface-variant truncate"><%= bank.nameTh %></span>
          </div>
        </label>
        <% }) %>
      </div>
    </div>
    </form>
  </div>

  <div class="xl:col-span-5 space-y-6">
    <div class="rounded-2xl bg-surface-container p-6 shadow-xl relative overflow-hidden">
      <div class="flex items-center justify-between pb-4">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-secondary text-lg">hourglass_top</span>
          <h3 class="font-headline font-bold text-base text-on-surface">สลิปล่าสุดที่กำลังประมวลผล</h3>
        </div>
        <span id="slipStatusBadge" class="px-2.5 py-1 rounded-full text-[10px] font-label font-bold bg-secondary/15 text-secondary flex items-center gap-1.5 shadow-[0_0_10px_rgba(0,255,204,0.2)] <%= latestSlip ? '' : 'hidden' %>">
          <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
          พร้อมตรวจสอบ
        </span>
      </div>
      <div id="slipResultPanel">
      <% if (latestSlip) { %>
      <% const bank = getBank(latestSlip.bankCode); %>
      <div class="bg-surface-container-low rounded-xl p-4 mb-5" data-testid="test_id_filePreview">
        <div class="flex gap-4 items-start">
          <div class="relative w-28 h-36 rounded-lg overflow-hidden bg-surface-container-highest shrink-0 shadow-md flex items-center justify-center">
            <span class="material-symbols-outlined text-[40px] text-on-surface-variant">description</span>
            <span class="absolute bottom-1.5 left-1.5 text-[9px] font-label font-bold text-secondary bg-surface-container-lowest/90 px-1 rounded">SLIP-IMG</span>
          </div>
          <div class="flex-1 min-w-0 flex flex-col justify-between h-36 py-0.5">
            <div>
              <span class="text-xs font-label font-bold text-on-surface truncate block"><%= latestSlip.fileName %></span>
              <span class="text-[11px] font-label text-on-surface-variant block mt-0.5"><%= latestSlip.sizeMb %> MB • ธ.<%= bank.nameTh %></span>
            </div>
            <div class="space-y-1.5 my-2">
              <div class="flex justify-between items-center text-xs">
                <span class="text-on-surface-variant">ร้านค้า</span>
                <span class="font-label font-bold text-on-surface text-sm truncate max-w-[60%]" data-testid="test_id_extractedShopName"><%= latestSlip.shopName || '-' %></span>
              </div>
              <div class="flex justify-between items-center text-xs">
                <span class="text-on-surface-variant">ยอดเงินที่ตรวจพบ</span>
                <span class="font-label font-bold text-secondary text-sm" data-testid="test_id_extractedTotalAmount">฿<%= Number(latestSlip.amount).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <% } else { %>
      <div class="bg-surface-container-low rounded-xl p-8 mb-5 text-center text-sm text-on-surface-variant font-body">
        ยังไม่มีสลิปที่อัปโหลด
      </div>
      <% } %>
      </div>
      <a href="https://opentyphoon.ai/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-1.5 mb-4 text-[10px] font-label text-on-surface-variant hover:text-secondary transition-colors">
        <span class="material-symbols-outlined text-xs">bolt</span>
        <span>Powered by <span class="font-bold text-on-surface">Typhoon OCR</span></span>
      </a>
      <button id="verifyBtn" class="w-full relative group overflow-hidden py-3.5 px-6 rounded-xl bg-surface-container-high text-on-surface font-headline font-bold text-sm tracking-wider flex items-center justify-center gap-3 transition-all duration-300 shadow-[0_0_24px_rgba(255,45,120,0.25)] hover:shadow-[0_0_32px_rgba(255,45,120,0.45)] hover:text-primary active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed" type="button" data-testid="test_id_uploadButton">
        <span class="absolute inset-0 bg-gradient-to-r from-primary/10 via-primary/20 to-primary/10 opacity-0 group-hover:opacity-100 transition-opacity"></span>
        <span class="relative z-10" id="verifyBtnLabel">ดำเนินการตรวจสอบข้อมูล (VERIFY)</span>
        <span class="material-symbols-outlined text-primary text-xl group-hover:translate-x-1.5 transition-transform relative z-10">arrow_forward</span>
      </button>
    </div>

    <div class="rounded-2xl bg-surface-container p-6 shadow-lg relative">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-8 h-8 rounded-lg bg-tertiary/15 flex items-center justify-center">
          <span class="material-symbols-outlined text-tertiary text-lg">lightbulb</span>
        </div>
        <div>
          <h4 class="font-headline font-bold text-sm text-on-surface">คำแนะนำเพื่อการสแกนที่แม่นยำ</h4>
          <p class="text-[11px] text-on-surface-variant font-body">เพิ่มประสิทธิภาพการประมวลผลให้รวดเร็วและถูกต้อง 99.8%</p>
        </div>
      </div>
      <div class="space-y-3">
        <div class="flex items-start gap-3 p-3 rounded-xl bg-surface-container-low">
          <div class="w-6 h-6 rounded-md bg-surface-container-high flex items-center justify-center shrink-0 mt-0.5 text-secondary">
            <span class="material-symbols-outlined text-sm">wb_sunny</span>
          </div>
          <div>
            <div class="text-xs font-semibold text-on-surface">แสงสว่างเพียงพอและทั่วถึง</div>
            <p class="text-[11px] text-on-surface-variant font-body mt-0.5 leading-relaxed">หลีกเลี่ยงเงาสะท้อนจากหลอดไฟ หรือเงามือที่บดบังส่วนข้อความสำคัญ</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-3 rounded-xl bg-surface-container-low">
          <div class="w-6 h-6 rounded-md bg-surface-container-high flex items-center justify-center shrink-0 mt-0.5 text-secondary">
            <span class="material-symbols-outlined text-sm">center_focus_strong</span>
          </div>
          <div>
            <div class="text-xs font-semibold text-on-surface">ตัวหนังสือคมชัด ไม่เบลอ</div>
            <p class="text-[11px] text-on-surface-variant font-body mt-0.5 leading-relaxed">ภาพต้นฉบับควรมีความละเอียดสูง ปราศจากการสั่นไหวของกล้องขณะบันทึกภาพ</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-3 rounded-xl bg-surface-container-low">
          <div class="w-6 h-6 rounded-md bg-surface-container-high flex items-center justify-center shrink-0 mt-0.5 text-tertiary">
            <span class="material-symbols-outlined text-sm">qr_code_scanner</span>
          </div>
          <div>
            <div class="text-xs font-semibold text-on-surface">เห็น QR Code และรหัสอ้างอิงชัดเจน</div>
            <p class="text-[11px] text-on-surface-variant font-body mt-0.5 leading-relaxed">อย่าให้ขอบของคิวอาร์โค้ดขาดหาย เพื่อให้ระบบตรวจสอบลายเซ็นดิจิทัลจากสถาบันการเงินได้ทันที</p>
          </div>
        </div>
      </div>
    </div>

    <div class="p-4 rounded-xl bg-surface-container-lowest flex items-center justify-between text-xs font-label text-on-surface-variant shadow-inner">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
        <span>BOT ENGINE OCR: READY FOR REAL-TIME PARSING</span>
      </div>
      <span class="text-secondary font-bold">256-BIT ENCRYPTED</span>
    </div>
  </div>
</div>
</div>
</main>
</div>
<script>
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('slipFileInput');
  const dropzoneLabel = document.getElementById('dropzoneLabel');
  const verifyBtn = document.getElementById('verifyBtn');
  const verifyBtnLabel = document.getElementById('verifyBtnLabel');
  const resultPanel = document.getElementById('slipResultPanel');
  const statusBadge = document.getElementById('slipStatusBadge');
  const errorBox = document.getElementById('uploadError');
  const errorText = document.getElementById('uploadErrorText');

  const ACCEPTED_TYPES = ['image/png', 'image/jpeg', 'application/pdf'];
  const MAX_SIZE_BYTES = 5 * 1024 * 1024;
  let selectedFile = null;

  function showError(message) {
    if (!errorBox || !errorText) return;
    errorText.textContent = message;
    errorBox.classList.remove('hidden');
  }

  function clearError() {
    if (!errorBox) return;
    errorBox.classList.add('hidden');
  }

  function validateFile(file) {
    if (!ACCEPTED_TYPES.includes(file.type)) {
      showError('รองรับเฉพาะไฟล์ PNG, JPG, JPEG หรือ PDF เท่านั้น');
      return false;
    }
    if (file.size > MAX_SIZE_BYTES) {
      showError('ขนาดไฟล์ต้องไม่เกิน 5MB');
      return false;
    }
    clearError();
    return true;
  }

  function renderPreview(file, dataUrl) {
    if (!resultPanel) return;
    resultPanel.innerHTML = `
      <div class="bg-surface-container-low rounded-xl p-4 mb-5" data-testid="test_id_filePreview">
        <div class="flex gap-4 items-start">
          <div class="relative w-28 h-36 rounded-lg overflow-hidden bg-surface-container-highest shrink-0 shadow-md">
            <img src="${dataUrl}" class="w-full h-full object-cover" alt="ตัวอย่างสลิปที่เลือก" />
            <button type="button" id="removeFileButton" data-testid="test_id_removeFileButton" aria-label="ลบไฟล์" class="absolute top-1 right-1 w-6 h-6 rounded-full bg-surface-container-lowest/90 hover:bg-error-container text-on-surface-variant hover:text-on-error-container flex items-center justify-center shadow-md transition-colors">
              <span class="material-symbols-outlined text-sm">close</span>
            </button>
          </div>
          <div class="flex-1 min-w-0 flex flex-col justify-between h-36 py-0.5">
            <div>
              <span class="text-xs font-label font-bold text-on-surface truncate block">${file.name}</span>
              <span class="text-[11px] font-label text-on-surface-variant block mt-0.5">${(file.size / (1024 * 1024)).toFixed(2)} MB</span>
            </div>
            <div id="slipStatusLine" class="text-xs text-on-surface-variant">พร้อมประมวลผล — กด VERIFY เพื่ออ่านข้อมูล</div>
          </div>
        </div>
      </div>`;
    if (statusBadge) statusBadge.classList.add('hidden');
    const removeBtn = document.getElementById('removeFileButton');
    if (removeBtn) removeBtn.addEventListener('click', removeSelectedFile);
  }

  function removeSelectedFile() {
    selectedFile = null;
    fileInput.value = '';
    dropzoneLabel.textContent = 'ลากสลิปมาวางที่นี่ หรือคลิกเพื่อค้นหา';
    if (resultPanel) {
      resultPanel.innerHTML = `
        <div class="bg-surface-container-low rounded-xl p-8 mb-5 text-center text-sm text-on-surface-variant font-body">
          ยังไม่มีสลิปที่อัปโหลด
        </div>`;
    }
    if (statusBadge) statusBadge.classList.add('hidden');
    clearError();
  }

  function showResult(data) {
    const statusLine = document.getElementById('slipStatusLine');
    if (statusLine) {
      statusLine.outerHTML = `
        <div class="space-y-1.5 my-2">
          <div class="flex justify-between items-center text-xs">
            <span class="text-on-surface-variant">ร้านค้า</span>
            <span class="font-label font-bold text-on-surface text-sm truncate max-w-[60%]" data-testid="test_id_extractedShopName">${data.shopName || '-'}</span>
          </div>
          <div class="flex justify-between items-center text-xs">
            <span class="text-on-surface-variant">ยอดเงินที่ตรวจพบ</span>
            <span class="font-label font-bold text-secondary text-sm" data-testid="test_id_extractedTotalAmount">฿${Number(data.amount || 0).toLocaleString('en-US', { minimumFractionDigits: 2 })}</span>
          </div>
        </div>`;
    }
    if (statusBadge) statusBadge.classList.remove('hidden');
  }

  function handleFile(file) {
    if (!file || !validateFile(file)) return;
    selectedFile = file;
    dropzoneLabel.textContent = file.name;

    const reader = new FileReader();
    reader.onload = (e) => renderPreview(file, e.target.result);
    reader.readAsDataURL(file);
  }

  if (dropzone && fileInput) {
    ['dragenter', 'dragover'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('bg-surface-container-high');
      }, false);
    });

    ['dragleave', 'drop'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('bg-surface-container-high');
      }, false);
    });

    dropzone.addEventListener('drop', (e) => {
      const files = e.dataTransfer.files;
      if (files.length > 0) {
        fileInput.files = files;
        handleFile(files[0]);
      }
    }, false);

    fileInput.addEventListener('change', () => {
      if (fileInput.files.length > 0) {
        handleFile(fileInput.files[0]);
      }
    });
  }

  if (verifyBtn) {
    verifyBtn.addEventListener('click', async () => {
      if (!selectedFile) {
        showError('กรุณาเลือกไฟล์สลิปก่อน');
        return;
      }
      clearError();
      const bankCode = document.querySelector('input[name="bankCode"]:checked');
      const formData = new FormData();
      formData.append('slipFile', selectedFile);
      if (bankCode) formData.append('bankCode', bankCode.value);

      verifyBtn.disabled = true;
      const originalLabel = verifyBtnLabel.textContent;
      verifyBtnLabel.textContent = 'กำลังประมวลผล...';

      try {
        const res = await fetch('/api/scan-slip', { method: 'POST', body: formData });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'เกิดข้อผิดพลาด กรุณาลองใหม่');
        showResult(data);
      } catch (err) {
        showError(err.message);
      } finally {
        verifyBtn.disabled = false;
        verifyBtnLabel.textContent = originalLabel;
      }
    });
  }
</script>
</body>
</html>
